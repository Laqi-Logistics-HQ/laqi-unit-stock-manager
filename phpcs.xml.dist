<?xml version="1.0"?>
<ruleset name="laqi-unit-stock-manager">
    <description>WordPress Coding Standards + PHP 7.4 compatibility for laqi-unit-stock-manager.</description>

    <file>.</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <!-- Tests use the WP test framework's own conventions (global $_tests_dir,
         WP_UnitTestCase file/class names) — don't lint them to plugin rules. -->
    <exclude-pattern>*/tests/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="WordPress"/>

    <!-- src/ is PSR-4 autoloaded: PascalCase filenames match class names, so
         WordPress's class-*.php file-naming rule doesn't apply there. -->
    <rule ref="WordPress.Files.FileName">
        <exclude-pattern>src/*</exclude-pattern>
    </rule>

    <!-- Fail on anything that won't run on PHP 7.4 (client servers). -->
    <config name="testVersion" value="7.4-"/>
    <rule ref="PHPCompatibilityWP"/>

    <!-- Recognise our text domain for i18n checks. -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="laqi-unit-stock-manager"/>
            </property>
        </properties>
    </rule>

    <!-- WooCommerce registers this capability for shop managers and admins. -->
    <rule ref="WordPress.WP.Capabilities">
        <properties>
            <property name="custom_capabilities" type="array">
                <element value="manage_woocommerce"/>
            </property>
        </properties>
    </rule>

    <!-- Prefix checks for globals/hooks/options. Use the unique Laqi brand plus
         plugin-initial prefix generated by new-plugin.sh. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="laqi_lusm_"/>
                <element value="LaqiUnitStockManager"/>
                <element value="LAQI_LUSM"/>
            </property>
        </properties>
        <!-- View partials are require()d inside a method, so their loop variables
             are method-scoped, not global — the prefix rule false-flags them. -->
        <exclude-pattern>templates/*</exclude-pattern>
    </rule>
</ruleset>
